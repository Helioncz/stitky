# Náhodný klíč pro podpis session cookie:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Prázdné = lokální SQLite v data/app.db. Na serveru Postgres (Supabase):
# DATABASE_URL=postgresql+psycopg://postgres.xxxx:HESLO@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Kam ukládat fotky a vydaná PDF (v Dockeru volume /data)
DATA_DIR=
# Adresa, na kterou vede QR kód na štítku
PUBLIC_BASE_URL=http://localhost:8000
# Registrace nových firem z přihlašovací stránky
ALLOW_SIGNUP=true
# Na HTTPS (produkce) true
HTTPS_ONLY_COOKIES=false

AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-2.5-flash
# AI_PROVIDER=claude  (pip install anthropic)
ANTHROPIC_API_KEY=
